<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Background="{StaticResource Primary}"
             x:Class="w12.MainPage"
             xmlns:viewmodel="clr-namespace:w12.ViewModels"
             xmlns:views="clr-namespace:w12.Views"
             x:DataType="viewmodel:MainPageViewModel"
             >
    <Grid Margin="5">
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="9*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="1" Text="{Binding UserName}" VerticalOptions="Center" TextColor="White" FontSize="Medium" HorizontalOptions="Start"  />
                <Button Grid.Column="2" ImageSource="sliders" BackgroundColor="{StaticResource PrimaryLight}" FontAttributes="Bold" CornerRadius="20" IsVisible="False"/>
                <Button Grid.Column="4" BackgroundColor="{StaticResource Secondary}"  TextColor="White" FontAttributes="Bold" CornerRadius="20" Text="Categorias" Command="{Binding NavigateToExerciseModelMagenimentPageCommand}"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" RowSpacing="10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="10" BackgroundColor="{StaticResource PrimaryLight}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20,20,20,20" />
                        </Border.StrokeShape>
                        <Border.Stroke>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Color="Transparent"
                                    Offset="0.1" />
                                <GradientStop Color="Transparent"
                                    Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="White" Opacity="0.5"  />
                        </Border.Shadow>
                        <Grid>
                            <Image Source="gb.jpg" Aspect="AspectFill" />
                            <StackLayout Spacing="15" Orientation="Vertical" VerticalOptions="Center" HorizontalOptions="Center">
                                <Image Source="plus" VerticalOptions="Center"   />
                                <Image Source="dumbbell" VerticalOptions="Center"  />
                                <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToAddExerciseCommand}"/>
                                </StackLayout.GestureRecognizers>
                            </StackLayout>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="10" BackgroundColor="{StaticResource PrimaryLight}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20,20,20,20" />
                        </Border.StrokeShape>
                        <Border.Stroke>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.1" />
                                <GradientStop Color="Transparent" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Stroke>
                        <Border.Shadow>
                            <Shadow Brush="White" Opacity="0.5" />
                        </Border.Shadow>
                        <Grid Margin="12,6" RowSpacing="1" VerticalOptions="CenterAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Text="Último Exercício:" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold"/>
                            <Label Grid.Row="1" Text="{Binding Execution.BaseExercise.Name}" TextColor="White" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" Margin="0,0,0,2"/>

                            <Label Grid.Row="2" Text="Peso(kg):" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold"/>
                            <Label Grid.Row="3" Text="{Binding Execution.Weight, StringFormat='{0} kg'}" TextColor="White" FontSize="14" FontAttributes="Bold"/>

                            <Label Grid.Row="4" Text="Reps:" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold"/>
                            <Label Grid.Row="5" Text="{Binding Execution.RepetitionCount}" TextColor="White" FontSize="14" FontAttributes="Bold"/>

                            <Label Grid.Row="6" Text="Número de séries:" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold"/>
                            <Label Grid.Row="7" Text="{Binding Execution.NumberOfSets}" TextColor="White" FontSize="14" FontAttributes="Bold"/>

                            <Label Grid.Row="8" Text="Data da Execução:" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold"/>
                            <Label Grid.Row="9" Text="{Binding Execution.ExecutionDate, StringFormat='{0:dd/MM/yyyy}'}" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <views:OneRepMaxCardView/>
                </Grid>
                <Grid Grid.Row="2" RowDefinitions="Auto, Auto" RowSpacing="10" Margin="10,0">
                    <!-- Card / Botão de Histórico -->
                    <Border StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource PrimaryLight}"
                            Padding="16,12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.25" Offset="0,2" Radius="6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToHistoryCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <!-- Ícone de Calendário/Relógio/Lista -->
                            <Image Source="history" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Histórico Completo" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Consulte todos os seus treinos e cargas" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="➔" TextColor="{StaticResource Secondary}" FontSize="18" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Versão discreta no rodapé -->
                    <Label Grid.Row="1" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Center" 
                       Text="Versão 1.0.0" 
                       FontSize="10"
                       TextColor="{StaticResource PrimaryDark}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
