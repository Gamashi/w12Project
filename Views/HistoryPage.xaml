<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:w12.Models"
             xmlns:viewmodels="clr-namespace:w12.ViewModels"
             x:Class="w12.Views.HistoryPage"
             x:DataType="viewmodels:HistoryViewModel"
             BackgroundColor="{StaticResource Primary}"
             Title="Histórico de Treinos">

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="15">

        <!-- 1. Barra de Busca estilizada com fundo nos tons do app -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0"
                BackgroundColor="{StaticResource PrimaryLight}"
                Padding="6,0">
            <SearchBar Placeholder="Buscar exercício ou data (dd/mm/aaaa)..."
                       Text="{Binding SearchText}"
                       PlaceholderColor="Gray"
                       TextColor="{StaticResource PrimaryDark}"
                       CancelButtonColor="{StaticResource PrimaryDark}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- 2. Loading Indicator nos tons do app -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- 3. Lista do Histórico -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredExecutions}"
                        SelectionMode="None">

            <!-- Estado Vazio quando não houver registros -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     Padding="20">
                    <Label Text="Nenhum exercício encontrado"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Tente buscar por outro termo ou data."
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExecutionExercise">
                    <Border Margin="0,6"
                            Padding="16"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource PrimaryLight}">

                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.25" Offset="0,2" Radius="5" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="6">

                            <!-- Nome do Exercício em Destaque -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding BaseExercise.Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />

                            <!-- Data da Execução -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ExecutionDate, StringFormat='{0:dd/MM/yyyy}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="Gray"
                                   VerticalOptions="Center" />

                            <!-- Séries, Repetições e Peso -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding NumberOfSets, StringFormat='{0} séries x'}" 
                                       FontSize="14" 
                                       TextColor="White" />
                                <Label Text="{Binding RepetitionCount, StringFormat='{0} reps'}" 
                                       FontSize="14" 
                                       TextColor="White" />
                                <Label Text="•" 
                                       FontSize="14" 
                                       TextColor="Gray" />
                                <Label Text="{Binding Weight, StringFormat='{0:F1} kg'}" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="White" />
                            </HorizontalStackLayout>

                            <!-- Observações (se preenchidas) -->
                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding Observations, StringFormat='Obs: {0}'}"
                                   FontSize="12"
                                   FontAttributes="Italic"
                                   TextColor="#CCCCCC"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>