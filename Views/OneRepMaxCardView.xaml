<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="w12.Views.OneRepMaxCardView">
    
    <Border Margin="10" BackgroundColor="{StaticResource PrimaryLight}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20,20,20,20" />
        </Border.StrokeShape>
        <Border.Stroke>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Color="Transparent"
                                    Offset="0.1" />
                <GradientStop Color="Transparent"
                                    Offset="1.0" />
            </LinearGradientBrush>
        </Border.Stroke>
        <Border.Shadow>
            <Shadow Brush="White"  Opacity="0.5"  />
        </Border.Shadow>
        <Grid RowSpacing="10" >
            <!-- 1. Imagem de Fundo -->
            <Image Source="gy"
                   Aspect="AspectFill" />
            
            <!--<BoxView Color="Black"
                     Opacity="0.1" />-->

            <Grid Padding="10" RowDefinitions="Auto, *, Auto">

                <Grid Grid.Row="0" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="0.1*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="trophy" Grid.Column="0" />
                    <Label Text="RECORDE PESSOAL (1RM)"
                           FontSize="15"
                           Grid.Column="1"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}" />
                    <Image Source="question.png" HorizontalOptions="End" Grid.Column="1" />
                </Grid>

                <VerticalStackLayout Grid.Row="1" VerticalOptions="Center">
                    <Label Text="{Binding BestExerciseName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="{Binding Best1RMEstimate, StringFormat='Maior carga est.: {0:F1} kg'}"
                           FontSize="14"
                           TextColor="#E0E0E0" />
                </VerticalStackLayout>


                <Button 
                    Grid.Row="2" 
                    Text="Toque para ver a evolução completa ➔" 
                    FontSize="12" 
                    TextColor="White"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    HorizontalOptions="End"
                    CornerRadius="20"
                    >
                </Button>
            </Grid>
        </Grid>
    </Border>
</ContentView>
